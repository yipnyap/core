{
  "presets": [
    "@babel/preset-env",
    "@babel/preset-react"
  ],
  "plugins": [
    "@babel/plugin-transform-runtime",
    [
      "module-resolver",
      {
        "root": [
          "./src"
        ],
        "alias": {
          "@nextgen2": "./src/nextgen2"
        }
      }
    ]
  ],
  "parserOpts": {
    "sourceType": "module",
    "allowImportExportEverywhere": true
  }
}
