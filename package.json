{
  "name": "yapsdk",
  "version": "1.0.0",
  "description": "The Yipnyap Experience",
  "main": "Gruntfile.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 0",
    "build": "grunt && npx tailwindcss -i \"./src/css/raw/styles.css\" -o \"./style.css\" && terser -c -m -o ./src/js/bundle.min.js -- ./src/js/bundle/bundle.js",
    "build_admin": "browserify ./src/js/source/admin.js --extension=jsx --extension=js -t [ babelify --presets [ @babel/env @babel/preset-react ] ] -g [ envify --NODE_ENV production ] -g uglifyify | terser --compress --mangle > ./src/js/admin.bundle.min.js",
    "dev:tailwind": "npx tailwindcss -i \"./src/css/raw/styles.css\" -o \"./style.css\" --watch",
    "dev:grunt": "grunt"
  },
  "author": "Rekkisomo",
  "devDependencies": {
    "@babel/core": "^7.18.6",
    "@babel/plugin-transform-runtime": "^7.19.6",
    "@babel/preset-env": "^7.11.5",
    "@babel/preset-react": "^7.10.4",
    "@headlessui/react": "^1.7.4",
    "@types/node": "^18.11.10",
    "@types/react": "^18.0.25",
    "@types/react-dom": "^18.0.9",
    "autoprefixer": "^9.8.6",
    "babelify": "^10.0.0",
    "browserify": "^17.0.0",
    "cssnano": "^5.1.14",
    "envify": "^4.1.0",
    "eslint": "^7.32.0",
    "grunt": "^1.3.0",
    "grunt-browserify": "^6.0.0",
    "grunt-contrib-concat": "^1.0.1",
    "grunt-contrib-uglify": "^4.0.1",
    "grunt-contrib-watch": "^1.1.0",
    "grunt-postcss": "^0.9.0",
    "grunt-sass": "^3.1.0",
    "moment": "^2.29.4",
    "react-router-dom": "^6.4.4",
    "sass": "^1.54.4",
    "terser": "^5.3.7",
    "uglifyify": "^5.0.0"
  },
  "dependencies": {
    "@babel/preset-typescript": "^7.18.6",
    "@heroicons/react": "^2.0.13",
    "@tailwindcss/forms": "^0.4.0",
    "@testing-library/react": "^13.4.0",
    "browserify-css": "^0.15.0",
    "concurrently": "^7.4.0",
    "lodash": "^4.17.21",
    "progressbar.js": "^1.1.0",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "simplebar": "^5.2.1",
    "simplebar-react": "^2.2.1",
    "tailwindcss": "^3.0.24",
    "tsify": "^5.0.4",
    "typescript": "^4.9.3"
  },
  "peerDependencies": {
    "postcss": "^8.0.0"
  }
